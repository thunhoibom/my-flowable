# Flow Admin BE (Design + Hub). Start Flow Engine first: it owns the database migrations of the tables
# Flow Admin BE reuses, and it authenticates every user of Flow Admin BE.
ADMIN_BE_PORT=8081
ADMIN_BE_DB_URL=jdbc:postgresql://localhost:5433/workflow_agent
ADMIN_BE_DB_USERNAME=workflow_agent
ADMIN_BE_DB_PASSWORD=workflow_agent

# Flow Engine itself (not through nginx): the service token signs the request path.
FLOW_ENGINE_URL=http://localhost:8080
FLOW_ENGINE_CLIENT_CODE=flow-admin-be
# Same value as FLOW_ADMIN_BE_SERVICE_SECRET of Flow Engine.
FLOW_ADMIN_BE_SERVICE_SECRET=change-me-flow-admin-be-secret
# Which base URL of a catalog entry belongs to this Flow Engine.
WORKFLOW_SERVICES_ENVIRONMENT=default

# Same key Flow Engine used for service secrets: the catalog rows were encrypted with it.
WORKFLOW_SERVICE_SECRET_KEY_BASE64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
WORKFLOW_EVENT_REGISTRY_ENABLED=true
