        </dependency>
        <dependency>
            <groupId>io.github.illuseahashmap</groupId>
            <artifactId>design-modeling</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.illuseahashmap</groupId>
            <artifactId>hub-admin</artifactId>
