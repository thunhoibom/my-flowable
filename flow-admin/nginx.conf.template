# Rendered at container start by the nginx image (envsubst over /etc/nginx/templates/*.template).
# FLOW_ENGINE_URL and FLOW_ADMIN_BE_URL come from the container environment, so one image
# works for every environment.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SSO login sets Keycloak access + refresh tokens as cookies; the default 4k buffer
    # is too small for those Set-Cookie headers ("upstream sent too big header").
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Flow Engine: Work area (and all current screens until phase 2 splits the API clients).
    location /api/engine/ {
        proxy_pass ${FLOW_ENGINE_URL}/;
    }

    # Flow Admin BE: Design and Hub areas.
    location /api/admin-be/ {
        proxy_pass ${FLOW_ADMIN_BE_URL}/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
