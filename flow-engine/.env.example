WORKFLOW_DB_URL=jdbc:postgresql://localhost:5432/workflow_agent
WORKFLOW_DB_USERNAME=workflow_agent
WORKFLOW_DB_PASSWORD=workflow_agent

# WORKFLOW_MASTER_KEY_BASE64 (set in the compose section below) is required by workflow security.
# Generate with:
#   powershell -NoProfile -Command "[Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))"
WORKFLOW_LOCAL_DEV_SECRET=change-me-local-dev-secret

# Allow deployments that contain a sandboxed JavaScript script task.
WORKFLOW_SCRIPT_TASK_ENABLED=true

# Largest BPMN document accepted for a draft or a published version, in bytes.
WORKFLOW_DEFINITION_MAX_BPMN_BYTES=2097152

# How many subprocesses may be nested inside one another.
WORKFLOW_SUBPROCESS_MAX_NESTING_DEPTH=3

# Call activity (calling another published process). On by default; set false to disable.
WORKFLOW_SUBPROCESS_CALL_ACTIVITY_ENABLED=true
# Longest chain of processes calling one another, the root included.
WORKFLOW_SUBPROCESS_MAX_CALL_DEPTH=5
WORKFLOW_SUBPROCESS_MAX_IO_PARAMETERS=64
# Event registry (event waits, channels). Manual wait steps work without it.
WORKFLOW_EVENT_REGISTRY_ENABLED=true
WORKFLOW_EVENT_REGISTRY_MAX_BODY_BYTES=262144
WORKFLOW_EVENT_REGISTRY_IDEMPOTENCY_RETENTION=7d

# ---- docker compose (compose.yaml) ----
# Local evaluation only. Replace every secret before using a shared environment.
POSTGRES_PASSWORD=workflow_agent
WORKFLOW_MASTER_KEY_BASE64=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

# Sign-in: Keycloak SSO only (realm "rsa"). Roles come from the token's eim_roles claim,
# assigned in EIM (WF_PLATFORM_ADMIN, WF_ADMIN, WF_OPERATOR, WF_VIEWER). Menu: EIM sitemap.
WORKFLOW_KEYCLOAK_SERVER_URL=https://uat-auth-sso.vetc.com.vn
WORKFLOW_KEYCLOAK_REALM=rsa
WORKFLOW_KEYCLOAK_CLIENT_ID=VETC.WORKFLOW
WORKFLOW_KEYCLOAK_CLIENT_SECRET=
WORKFLOW_KEYCLOAK_ALLOWED_CLIENT_IDS=VETC.WORKFLOW
WORKFLOW_EIM_APP_CODE=VETC.WORKFLOW
